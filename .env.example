# 复制为 .env 后修改（docker compose 自动读取）

# 必填：音箱能访问到的 NAS 局域网地址（不要填 127.0.0.1 / Docker 网桥地址）
WUSHUANG_PUBLIC_URL=http://192.168.1.10:8080

# 管理后台初始密码（首次启动生效，登录后请在后台修改）
WUSHUANG_ADMIN_PASSWORD=change-me

# 宿主机音乐目录（映射到容器 /music）
MUSIC_DIR=./music

# 后台端口（一般不用改）
WUSHUANG_PORT=8080

# 构建加速（国内默认腾讯/npmmirror，海外可改回官方源）
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple/
NPM_REGISTRY=https://registry.npmmirror.com
